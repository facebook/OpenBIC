/* flexcomm2_lpi2c2 (LCD-shield header I2C, unused by this port - only
 * flexcomm3_lpi2c3/Arduino-header is used, see plat_i2c.h) triggers a
 * real divide-by-zero crash in NXP's own MCUX LPI2C driver
 * (LPI2C_MasterInit -> LPI2C_GetCyclesForWidth, modules/hal/nxp/.../
 * fsl_lpi2c.c:166) during automatic boot-time init on this SoC/Zephyr
 * combination - confirmed on real hardware via GDB + addr2line
 * (USAGE FAULT, "Division by zero", identical PC/registers every
 * time). This bus shares FlexComm2 with an audio codec node in the
 * board's own devicetree, which may be why its clock-rate query
 * returns near-zero. Since nothing in this port uses this bus,
 * disabling it is the correct fix, not a workaround - see README.md.
 */
&flexcomm2_lpi2c2 {
	status = "disabled";
};

/* red_led (D2 red channel) is enabled by the board's own devicetree.
 *
 * user_button_2 (SW2, gpio1.3, active-low w/ pull-up) is disabled by
 * default on this board - enabled here for the GPIO status-monitoring
 * subsystem in src/plat_gpio.c, standing in for a real BIC's
 * power-good/host-presence input until actual platform signals are
 * wired up.
 */
&user_button_2 {
	status = "okay";
};

/* Inter-core mailbox endpoint for the dual-core subsystem
 * (src/plat_mbox.c) - only exercised when built with sysbuild
 * (west build --sysbuild), pairing with remote/boards/
 * mcx_n9xx_evk_mcxn947_cpu1.overlay's swapped tx/rx channels.
 */
/ {
	mbox-consumer {
		compatible = "vnd,mbox-consumer";
		mboxes = <&mbox 1>, <&mbox 0>;
		mbox-names = "tx", "rx";
	};
};
